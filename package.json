{
  "name": "nonza",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:app": "turbo run build:app",
    "build:tauri": "npm run build:tauri --workspace=@nonza/meet",
    "dev": "turbo dev",
    "dev:rooms": "turbo run dev:rooms",
    "dev:ui-kit": "turbo run dev --filter=@nonza/ui-kit",
    "dev:tauri": "npm run dev:tauri --workspace=@nonza/meet",
    "lint": "turbo lint",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
