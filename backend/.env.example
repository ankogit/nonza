# HTTP Server
HTTP_PORT=8000
HTTP_READ_TIMEOUT=100s
HTTP_WRITE_TIMEOUT=100s

# WebRTC Platform
WEBRTC_PLATFORM=livekit
# Внутренний URL LiveKit (для локальной разработки = localhost)
WEBRTC_URL=ws://localhost:7880
# Публичный URL LiveKit для браузера (обязательно на проде: wss://, иначе Mixed Content).
# Если пусто — в ответе токена используется WEBRTC_URL.
# WEBRTC_PUBLIC_URL=wss://livekit.nonza.ru
WEBRTC_API_KEY=devkey
# Должен совпадать с keys.<WEBRTC_API_KEY> в deploy/livekit-config.dev.yaml (для локальной разработки)
WEBRTC_API_SECRET=SjhHHIUvnFKcZrODPlmaKvOUImzOjpWHxuuvyIYF

# Внешний TURN (coturn): URL для клиента и секрет для HMAC (lt-cred-mech).
# Секрет должен совпадать с coturn. При use-auth-secret в coturn.conf задай TURN_USE_AUTH=1.
# TURN_URL=turns:turn.nonza.ru:5349
# TURN_SECRET=your_turn_secret_min_32_chars
# TURN_TTL=86400
# TURN_USE_AUTH=1

# Audio Settings
AUDIO_CODEC=opus
AUDIO_BITRATE=32000
AUDIO_SAMPLE_RATE=48000
AUDIO_USE_INBAND_FEC=true
AUDIO_CHANNELS=1

# Security
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=7d
E2EE_ENABLED=true
E2EE_REQUIRE=true
E2EE_KEY_ROTATION_INTERVAL=1h
E2EE_FALLBACK_WARNING=true

# Rate Limiting
RATE_LIMIT_TOKENS_PER_MINUTE=20
RATE_LIMIT_BURST=5

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nonza
DB_PASSWORD=nonza_password
DB_DATABASE=nonza
DB_SSL_MODE=disable

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_USE_SSL=false

# S3 / MinIO
S3_ENDPOINT=localhost:19000
S3_ACCESS_KEY=nonza_minio
S3_SECRET_KEY=nonza_minio_password
S3_BUCKET=nonza-files
S3_USE_SSL=false
S3_REGION=us-east-1
# For local MinIO via docker-compose:
S3_PUBLIC_BASE_URL=http://localhost:19000/nonza-files

# LiveKit Server (если self-host)
LIVEKIT_SERVER_HOST=localhost
LIVEKIT_SERVER_PORT=7880
LIVEKIT_REDIS_URL=redis://localhost:6379/0

# Cache
CACHE_TTL=60s

# Environment
ENV=local
DEBUG=false

# CORS (production): origins через запятую, с которых разрешены запросы к API
# Пример: https://meet.nonza.ru,https://www.nonza.ru
# CORS_ALLOWED_ORIGINS=https://meet.nonza.ru

# Каталог с артефактами десктоп-приложения для скачивания (Windows .msi, macOS .dmg).
# GET /api/v1/desktop-download/windows и /macos отдают первый найденный .msi и .dmg из каталога.
# Если пусто — эндпоинты возвращают 404.
# DESKTOP_DOWNLOAD_DIR=/var/nonza/desktop-artifacts
