# API Base URL
# REST API бэкенда (комнаты, токены, проверка обновлений десктоп-приложения).
# Для Tauri перед dev/build в tauri.conf.json подставляется этот URL в эндпоинт обновлений.
VITE_API_BASE_URL=http://localhost:8000

# LiveKit WebSocket URL
# WebSocket сервер LiveKit для WebRTC соединений (видео/аудио потоки)
# Протокол: WS/WSS (WebSocket)
# Порт: 7880 (по умолчанию)
# ВАЖНО: Это НЕ API URL, а отдельный сервер LiveKit
VITE_LIVEKIT_URL=ws://localhost:7880

# Для production используйте:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_LIVEKIT_URL=wss://livekit.yourdomain.com
