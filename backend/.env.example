# HTTP Server
HTTP_PORT=8000
HTTP_READ_TIMEOUT=100s
HTTP_WRITE_TIMEOUT=100s

# WebRTC Platform
WEBRTC_PLATFORM=livekit
# Внутренний URL LiveKit (для локальной разработки = localhost)
WEBRTC_URL=ws://localhost:7880
# Публичный URL LiveKit для браузера (обязательно на проде: wss://, иначе Mixed Content).
# Если пусто — в ответе токена используется WEBRTC_URL.
# WEBRTC_PUBLIC_URL=wss://livekit.nonza.ru
WEBRTC_API_KEY=devkey
# Должен совпадать с keys.<WEBRTC_API_KEY> в deploy/livekit-config.dev.yaml (для локальной разработки)
WEBRTC_API_SECRET=SjhHHIUvnFKcZrODPlmaKvOUImzOjpWHxuuvyIYF

# Внешний TURN (coturn): URL для клиента и секрет для HMAC (lt-cred-mech).
# Секрет должен совпадать с coturn. При use-auth-secret в coturn.conf задай TURN_USE_AUTH=1.
# TURN_URL=turns:turn.nonza.ru:5349
# TURN_SECRET=your_turn_secret_min_32_chars
# TURN_TTL=86400
# TURN_USE_AUTH=1

# Audio Settings
AUDIO_CODEC=opus
AUDIO_BITRATE=32000
AUDIO_SAMPLE_RATE=48000
AUDIO_USE_INBAND_FEC=true
AUDIO_CHANNELS=1

# Security
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=90d
E2EE_ENABLED=true
E2EE_REQUIRE=true
E2EE_KEY_ROTATION_INTERVAL=1h
E2EE_FALLBACK_WARNING=true

# Rate Limiting
RATE_LIMIT_TOKENS_PER_MINUTE=20
RATE_LIMIT_BURST=5

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nonza
DB_PASSWORD=nonza_password
DB_DATABASE=nonza
DB_SSL_MODE=disable

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_USE_SSL=false

# S3 / MinIO
S3_ENDPOINT=localhost:19000
S3_ACCESS_KEY=nonza_minio
S3_SECRET_KEY=nonza_minio_password
S3_BUCKET=nonza-files
S3_USE_SSL=false
S3_REGION=us-east-1
# For local MinIO via docker-compose:
S3_PUBLIC_BASE_URL=http://localhost:19000/nonza-files

# LiveKit Server (если self-host)
LIVEKIT_SERVER_HOST=localhost
LIVEKIT_SERVER_PORT=7880
LIVEKIT_REDIS_URL=redis://localhost:6379/0

# Cache
CACHE_TTL=60s

# Environment
ENV=local
DEBUG=false

# CORS (production): origins через запятую, с которых разрешены запросы к API
# Пример: https://meet.nonza.ru,https://www.nonza.ru
# CORS_ALLOWED_ORIGINS=https://meet.nonza.ru

# OAuth: публичный URL rooms SPA для редиректа на экран authorize
# OAUTH_UI_BASE_URL=http://localhost:3001

# Публичный URL meets-виджета (join_url = {MEETS_PUBLIC_BASE_URL}/?code=...)
# MEETS_PUBLIC_BASE_URL=http://localhost:3002

# Social login (Google на Nonza + SSO MandarinShow)
# AUTH_PUBLIC_BASE_URL=http://localhost:8000
# AUTH_ENABLE_PASSWORD=true
# AUTH_ENABLE_GOOGLE=false
# AUTH_ENABLE_MANDARINSHOW=false
# AUTH_ENABLE_KEYCLOAK=false
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# MandarinShow OAuth (authorization code → POST /oauth/token)
# MANDARINSHOW_CLIENT_ID=
# MANDARINSHOW_CLIENT_SECRET=
# MANDARINSHOW_AUTHORIZE_URL=https://mandarinshow.ru/oauth/authorize
# MANDARINSHOW_TOKEN_URL=https://mandarinshow.ru/oauth/token
# MANDARINSHOW_REDIRECT_URI=http://localhost:8000/api/v1/auth/mandarinshow/callback
# Keycloak OIDC (отдельный client в realm, не security-admin-console)
# KEYCLOAK_ISSUER=https://keycloak.infra.cf.team/realms/master
# KEYCLOAK_CLIENT_ID=nonza
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/auth/keycloak/callback

# --- Desktop artifacts via backend (DEPRECATED) ---
# Новый клиент качает установщики и обновления с GitHub Releases
# (см. apps/meet/src-tauri/BUILD.md). Эти переменные только для старых деплоев.
#
# DESKTOP_APP_UPDATE_JSON={"version":"0.1.1","notes":"","pub_date":"2025-03-17T12:00:00Z","platforms":{"darwin-aarch64":{"url":"https://...","signature":"..."},"windows-x86_64":{"url":"https://...","signature":"..."}}}
# DESKTOP_DOWNLOAD_DIR=/var/nonza/desktop-artifacts
