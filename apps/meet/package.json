{
  "name": "@nonza/meet",
  "version": "0.1.0",
  "type": "module",
  "description": "Nonza Video Call Widget - Vue 3 library for embedding video calls",
  "main": "./dist/nonza-widget.umd.js",
  "module": "./dist/nonza-widget.es.js",
  "types": "./dist/nonza-widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nonza-widget.d.ts",
      "import": "./dist/nonza-widget.es.js",
      "require": "./dist/nonza-widget.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:rooms": "vite --mode rooms",
    "dev:tauri": "node scripts/patch-tauri-update-url.js && tauri dev",
    "build": "vue-tsc && vite build",
    "build:app": "vue-tsc && vite build --config vite.app.config.ts",
    "build:desktop": "vue-tsc && vite build --config vite.app.config.ts --mode rooms",
    "build:tauri": "node scripts/patch-tauri-update-url.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tiptap/core": "^3.18.0",
    "@tiptap/extension-collaboration": "^3.18.0",
    "@tiptap/extension-collaboration-caret": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/markdown": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@tiptap/vue-3": "^3.18.0",
    "livekit-client": "^2.17.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.26",
    "vue3-emoji-picker": "^1.1.8",
    "wavesurfer.js": "^7.12.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^14.6.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.3.0",
    "vue-tsc": "^2.1.27"
  }
}
